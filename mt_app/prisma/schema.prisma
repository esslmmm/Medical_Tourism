generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model action_history {
  action_id   Int                         @id @default(autoincrement())
  user_id     Int
  type_action action_history_type_action?
  timestamp   DateTime?                   @db.Timestamp(0)
  action      String?                     @db.VarChar(255)
  id          Int?
  users       users                       @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "action_history_ibfk_1")

  @@index([user_id], map: "user_id")
}

model appointments {
  appointment_id   Int                @id @default(autoincrement())
  date             DateTime?          @db.Date
  timeslot         String?            @db.VarChar(255)
  patient_id       Int?
  description      String?            @db.Text
  doctor_id        Int?
  file_name        String?            @db.VarChar(255)
  file_path        String?            @db.VarChar(255)
  upload_date      DateTime?          @db.Timestamp(0)
  patient_deatils  patient_deatils?   @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction, map: "appointments_ibfk_1")
  doctors          doctors?           @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "appointments_ibfk_2")
  package_bookings package_bookings[]

  @@index([doctor_id], map: "doctor_id")
  @@index([patient_id], map: "patient_id")
}

model cars {
  car_id           Int                @id @default(autoincrement())
  car_name         String?            @db.VarChar(50)
  phone            Int?
  email            String?            @db.VarChar(100)
  address          String?            @db.VarChar(255)
  city             String?            @db.VarChar(255)
  image            String?            @db.VarChar(255)
  description      String?            @db.Text
  fee              Float?             @db.Float
  capacity         Int?
  guide_license    String?            @db.VarChar(255)
  tourism_bookings tourism_bookings[]
}

model contact_deatils {
  contact_id       Int                @id @default(autoincrement())
  firstname        String?            @db.VarChar(255)
  lastname         String?            @db.VarChar(255)
  email            String?            @db.VarChar(255)
  country          String?            @db.VarChar(255)
  phone            Int?
  package_bookings package_bookings[]
}

model description {
  description_id Int       @id @default(autoincrement())
  package_id     Int?
  details        String?   @db.VarChar(255)
  packages       packages? @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction, map: "description_ibfk_1")

  @@index([package_id], map: "package_id")
}

model doc_certificate {
  cerfiticate_id Int      @id @default(autoincrement())
  doctor_id      Int?
  field_of_study String?  @db.VarChar(255)
  institution    String?  @db.VarChar(255)
  year           Int?
  doctors        doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_certificate_ibfk_1")

  @@index([doctor_id], map: "doctor_id")
}

model doc_education {
  education_id   Int      @id @default(autoincrement())
  doctor_id      Int?
  field_of_study String?  @db.VarChar(255)
  institution    String?  @db.VarChar(255)
  year           Int?
  doctors        doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_education_ibfk_1")

  @@index([doctor_id], map: "doctor_id")
}

model doc_language {
  language_id Int      @id @default(autoincrement())
  doctor_id   Int?
  languages   String?  @db.VarChar(255)
  doctors     doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_language_ibfk_1")

  @@index([doctor_id], map: "doctor_id")
}

model doctors {
  doctor_id       Int               @id @default(autoincrement())
  name            String?           @db.VarChar(255)
  specialization  String?           @db.VarChar(255)
  hospital_id     Int?
  experience      Int?
  description     String?           @db.VarChar(200)
  image           String?           @db.VarChar(255)
  create_at       DateTime?         @default(now())
  appointments    appointments[]
  doc_certificate doc_certificate[]
  doc_education   doc_education[]
  doc_language    doc_language[]
  hospitals       hospitals?        @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction, map: "doctors_ibfk_1")
  package_doc     package_doc[]

  @@index([hospital_id], map: "hospital_id")
}

model hospitals {
  hospital_id      Int                @id @default(autoincrement())
  name             String?            @db.VarChar(100)
  hospital_code    String?            @db.VarChar(20)
  location         String?            @db.VarChar(255)
  city             String?            @db.VarChar(50)
  description      String?            @db.Text
  contact_info     String?            @db.VarChar(255)
  rating           Float?             @db.Float
  image            String?            @db.VarChar(255)
  logo             String             @db.VarChar(255)
  create_at        DateTime?          @default(now()) @db.Timestamp(3)
  doctors          doctors[]
  hospital_images  hospital_images[]
  medical_services medical_services[]
  packages         packages[]
  review_hospital  review_hospital[]
}

model hotel_bookings {
  booking_id       Int                    @id @default(autoincrement())
  hotel_id         Int?
  check_in_date    DateTime?              @db.Date
  check_out_date   DateTime?              @db.Date
  guest_children   Int?
  guest_adult      Int?
  total_price      Float?                 @db.Float
  status           hotel_bookings_status?
  hotels           hotels?                @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_bookings_ibfk_1")
  package_bookings package_bookings[]
  room_aggregate   room_aggregate[]

  @@index([hotel_id], map: "hotel_id")
}

model hotel_facilities {
  facility_id   Int     @id @default(autoincrement())
  hotel_id      Int?
  facility_name String? @db.VarChar(100)
  description   String? @db.Text
  hotels        hotels? @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_facilities_ibfk_1")

  @@index([hotel_id], map: "hotel_id")
}

model hotel_images {
  image_id Int     @id @default(autoincrement())
  hotel_id Int?
  image    String? @db.VarChar(255)
  hotels   hotels? @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_images_ibfk_1")

  @@index([hotel_id], map: "hotel_id")
}

model hotel_room_facilities {
  room_facilitiy_id Int          @id @default(autoincrement())
  room_id           Int?
  facility_name     String?      @db.VarChar(100)
  description       String?      @db.Text
  hotel_rooms       hotel_rooms? @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_room_facilities_ibfk_1")

  @@index([room_id], map: "room_id")
}

model hotel_rooms {
  room_id               Int                     @id @default(autoincrement())
  hotel_id              Int?
  room_type             String?                 @db.VarChar(100)
  price_per_night       Float?                  @db.Float
  capacity              String?                 @db.VarChar(200)
  description           String?                 @db.Text
  image                 String?                 @db.VarChar(255)
  hotel_room_facilities hotel_room_facilities[]
  hotels                hotels?                 @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_rooms_ibfk_1")
  room_aggregate        room_aggregate[]
  room_image            room_image[]

  @@index([hotel_id], map: "hotel_id")
}

model hotels {
  hotel_id         Int                @id @default(autoincrement())
  name             String?            @db.VarChar(255)
  hotel_code       String?            @db.VarChar(20)
  location         String?            @db.VarChar(255)
  city             String?            @db.VarChar(100)
  rating           Float?             @db.Float
  email            String?            @db.VarChar(50)
  description      String?            @db.Text
  image            String?            @db.VarChar(255)
  contact_info     String?            @db.VarChar(255)
  create_at        DateTime           @default(now()) @db.Timestamp(0)
  hotel_bookings   hotel_bookings[]
  hotel_facilities hotel_facilities[]
  hotel_images     hotel_images[]
  hotel_rooms      hotel_rooms[]
  package_hotels   package_hotels[]
  review_hotel     review_hotel[]
}

model inter_bookings {
  booking_id       Int                    @id @default(autoincrement())
  interpreter_id   Int?
  start            DateTime?              @db.Date
  end              DateTime?              @db.Date
  status           inter_bookings_status?
  interpreters     interpreters?          @relation(fields: [interpreter_id], references: [interpreter_id], onDelete: NoAction, onUpdate: NoAction, map: "inter_bookings_ibfk_1")
  package_bookings package_bookings[]

  @@index([interpreter_id], map: "interpreter_id")
}

model inter_education {
  education_id   Int           @id @default(autoincrement())
  interpreter_id Int?
  degree         String?       @db.VarChar(50)
  field_of_study String?       @db.VarChar(255)
  institution    String?       @db.VarChar(100)
  interpreters   interpreters? @relation(fields: [interpreter_id], references: [interpreter_id], onDelete: NoAction, onUpdate: NoAction, map: "inter_education_ibfk_1")

  @@index([interpreter_id], map: "interpreter_id")
}

model interpreters {
  interpreter_id       Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  email                String                 @unique(map: "email") @db.VarChar(255)
  phone                String                 @db.VarChar(50)
  rating               Float                  @db.Float
  nationality          String                 @db.VarChar(100)
  image                String                 @db.VarChar(255)
  birthofday           DateTime               @db.Date
  address              String                 @db.Text
  profile_summary      String                 @db.Text
  language             interpreters_language
  create_at            DateTime               @default(now()) @db.Timestamp(0)
  inter_bookings       inter_bookings[]
  inter_education      inter_education[]
  languages            languages[]
  package_interpreters package_interpreters[]
  review_inter         review_inter[]
}

model languages {
  lang_id        Int                    @id @default(autoincrement())
  interpreter_id Int?
  language_name  String?                @db.VarChar(100)
  proficiency    languages_proficiency?
  interpreters   interpreters?          @relation(fields: [interpreter_id], references: [interpreter_id], onDelete: NoAction, onUpdate: NoAction, map: "languages_ibfk_1")

  @@index([interpreter_id], map: "interpreter_id")
}

model login {
  login_id   Int       @id @default(autoincrement())
  user_id    Int?
  login_time DateTime? @db.Timestamp(0)
  users      users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "login_ibfk_1")

  @@index([user_id], map: "user_id")
}

model medical_services {
  service_id   Int        @id @default(autoincrement())
  hospital_id  Int?
  service_name String?    @db.VarChar(255)
  description  String?    @db.VarChar(255)
  hospitals    hospitals? @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction, map: "medical_services_ibfk_1")

  @@index([hospital_id], map: "hospital_id")
}

model messages {
  message_id                        Int       @id @default(autoincrement())
  chat_id                           Int
  sender_id                         Int?
  receiver_id                       Int?
  message                           String?   @db.Text
  timestamp                         DateTime? @default(now()) @db.Timestamp(0)
  users_messages_sender_idTousers   users?    @relation("messages_sender_idTousers", fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "messages_ibfk_1")
  users_messages_receiver_idTousers users?    @relation("messages_receiver_idTousers", fields: [receiver_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "messages_ibfk_2")
  chat                              chat      @relation(fields: [chat_id], references: [chat_id], onUpdate: Restrict, map: "messages_ibfk_3")

  @@index([receiver_id], map: "receiver_id")
  @@index([sender_id], map: "sender_id")
  @@index([chat_id], map: "chat_id")
}

model package_bookings {
  booking_id         Int                     @id @default(autoincrement())
  user_id            Int
  package_id         Int
  tourism_booking_id Int
  appointment_id     Int
  hotel_booking_id   Int
  contact_id         Int
  inter_booking_id   Int
  create_at          DateTime                @default(now()) @db.Timestamp(0)
  status             package_bookings_status
  users              users                   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_1")
  packages           packages                @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_2")
  tourism_bookings   tourism_bookings        @relation(fields: [tourism_booking_id], references: [tourism_id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_3")
  appointments       appointments            @relation(fields: [appointment_id], references: [appointment_id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_4")
  hotel_bookings     hotel_bookings          @relation(fields: [hotel_booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_5")
  contact_deatils    contact_deatils         @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_6")
  inter_bookings     inter_bookings          @relation(fields: [inter_booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_7")
  payment            payment[]

  @@index([appointment_id], map: "appointment_id")
  @@index([contact_id], map: "contact_id")
  @@index([hotel_booking_id], map: "hotel_booking_id")
  @@index([inter_booking_id], map: "inter_booking_id")
  @@index([package_id], map: "package_id")
  @@index([tourism_booking_id], map: "tourism_booking_id")
  @@index([user_id], map: "user_id")
}

model package_doc {
  doc_id     Int       @id @default(autoincrement())
  package_id Int?
  doctor_id  Int?
  packages   packages? @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction, map: "package_doc_ibfk_1")
  doctors    doctors?  @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "package_doc_ibfk_2")

  @@index([doctor_id], map: "doctor_id")
  @@index([package_id], map: "package_id")
}

model package_hotels {
  packhotel_id Int       @id @default(autoincrement())
  package_id   Int?
  hotel_id     Int?
  packages     packages? @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction, map: "package_hotels_ibfk_1")
  hotels       hotels?   @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction, map: "package_hotels_ibfk_2")

  @@index([hotel_id], map: "hotel_id")
  @@index([package_id], map: "package_id")
}

model package_image {
  image_id   Int       @id @default(autoincrement())
  package_id Int?
  images     String?   @db.VarChar(255)
  packages   packages? @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction, map: "package_image_ibfk_1")

  @@index([package_id], map: "package_id")
}

model package_interpreters {
  inter_id       Int           @id @default(autoincrement())
  package_id     Int?
  interpreter_id Int?
  packages       packages?     @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction, map: "package_interpreters_ibfk_1")
  interpreters   interpreters? @relation(fields: [interpreter_id], references: [interpreter_id], onDelete: NoAction, onUpdate: NoAction, map: "package_interpreters_ibfk_2")

  @@index([interpreter_id], map: "interpreter_id")
  @@index([package_id], map: "package_id")
}

model package_places {
  packplace_id    Int              @id @default(autoincrement())
  tour_id         Int?
  place_id        Int?
  date            DateTime?        @db.Date
  start           DateTime?        @db.Time(0)
  end             DateTime?        @db.Time(0)
  tourismservices tourismservices? @relation(fields: [tour_id], references: [tour_id], onDelete: NoAction, onUpdate: NoAction, map: "package_places_ibfk_1")
  places          places?          @relation(fields: [place_id], references: [place_id], onDelete: NoAction, onUpdate: NoAction, map: "package_places_ibfk_2")

  @@index([place_id], map: "place_id")
  @@index([tour_id], map: "tour_id")
}

model packages {
  package_id           Int                    @id @default(autoincrement())
  package_name         String?                @db.VarChar(255)
  package_type         packages_package_type?
  hospital_id          Int?
  tour_id              Int?
  image                String?                @db.VarChar(255)
  detail               String?                @db.VarChar(100)
  duration             Int?
  expired_date         DateTime?              @db.Date
  create_at            DateTime               @default(now()) @db.Timestamp(0)
  description          description[]
  package_bookings     package_bookings[]
  package_doc          package_doc[]
  package_hotels       package_hotels[]
  package_image        package_image[]
  package_interpreters package_interpreters[]
  hospitals            hospitals?             @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction, map: "packages_ibfk_1")
  tourismservices      tourismservices?       @relation(fields: [tour_id], references: [tour_id], onDelete: NoAction, onUpdate: NoAction, map: "packages_ibfk_2")

  @@index([hospital_id], map: "hospital_id")
  @@index([tour_id], map: "tour_id")
}

model patient_deatils {
  patient_id      Int                     @id @default(autoincrement())
  firstname       String?                 @db.VarChar(255)
  lastname        String?                 @db.VarChar(255)
  gender          patient_deatils_gender?
  dateofbirth     DateTime?               @db.Date
  nationality     String?                 @db.VarChar(255)
  passport_number String?                 @db.VarChar(255)
  appointments    appointments[]
}

model payment {
  payment_id       Int                     @id @default(autoincrement())
  uer_id           Int?
  booking_id       Int?
  payment_date     DateTime?               @db.DateTime(0)
  payment_method   String?                 @db.VarChar(255)
  amount           Decimal?                @db.Decimal(10, 0)
  payment_status   payment_payment_status?
  transaction_id   String?                 @db.VarChar(50)
  users            users?                  @relation(fields: [uer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "payment_ibfk_1")
  package_bookings package_bookings?       @relation(fields: [booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction, map: "payment_ibfk_2")

  @@index([booking_id], map: "booking_id")
  @@index([uer_id], map: "uer_id")
}

model place_image {
  image_id Int     @id @default(autoincrement())
  place_id Int?
  image    String? @db.VarChar(255)
  places   places? @relation(fields: [place_id], references: [place_id], onDelete: Restrict, onUpdate: Restrict, map: "place_image_ibfk_2")

  @@index([place_id], map: "Place_id")
}

model places {
  place_id       Int              @id @default(autoincrement())
  place_name     String?          @db.VarChar(100)
  contact_info   String?          @db.VarChar(255)
  location       String?          @db.VarChar(255)
  city           String?          @db.VarChar(255)
  image          String?          @db.VarChar(255)
  description    String?          @db.Text
  fee            Float?           @db.Float
  package_places package_places[]
  place_image    place_image[]
}

model review_hospital {
  review_id    Int       @id @default(autoincrement())
  user_id      Int
  hospital_id  Int
  rating       Float?    @db.Float
  title_review String?   @db.Text
  comment      String?   @db.Text
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "review_hospital_ibfk_1")
  hospitals    hospitals @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction, map: "review_hospital_ibfk_2")

  @@index([hospital_id], map: "hospital_id")
  @@index([user_id], map: "user_id")
}

model review_hotel {
  review_id    Int       @id @default(autoincrement())
  user_id      Int
  hotel_id     Int
  rating       Float?    @db.Float
  title_review String?   @db.Text
  comment      String?   @db.Text
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "review_hotel_ibfk_1")
  hotels       hotels    @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction, map: "review_hotel_ibfk_2")

  @@index([hotel_id], map: "hotel_id")
  @@index([user_id], map: "user_id")
}

model review_inter {
  review_id      Int          @id @default(autoincrement())
  user_id        Int
  interpreter_id Int
  rating         Float?       @db.Float
  title_review   String?      @db.Text
  comment        String?      @db.Text
  created_at     DateTime?    @default(now()) @db.Timestamp(0)
  users          users        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "review_inter_ibfk_1")
  interpreters   interpreters @relation(fields: [interpreter_id], references: [interpreter_id], onDelete: NoAction, onUpdate: NoAction, map: "review_inter_ibfk_2")

  @@index([interpreter_id], map: "interpreter_id")
  @@index([user_id], map: "user_id")
}

model room_aggregate {
  aggregate_id   Int             @id @default(autoincrement())
  room_id        Int?
  booking_id     Int?
  amount         Int
  hotel_rooms    hotel_rooms?    @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction, map: "room_aggregate_ibfk_1")
  hotel_bookings hotel_bookings? @relation(fields: [booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction, map: "room_aggregate_ibfk_2")

  @@index([booking_id], map: "booking_id")
  @@index([room_id], map: "room_id")
}

model room_image {
  image_id    Int          @id @default(autoincrement())
  room_id     Int?
  image       String?      @db.VarChar(255)
  hotel_rooms hotel_rooms? @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction, map: "room_image_ibfk_1")

  @@index([room_id], map: "room_id")
}

model tourism_bookings {
  tourism_id       Int                      @id @default(autoincrement())
  tour_id          Int?
  car_id           Int?
  status           tourism_bookings_status?
  package_bookings package_bookings[]
  tourismservices  tourismservices?         @relation(fields: [tour_id], references: [tour_id], onDelete: NoAction, onUpdate: NoAction, map: "tourism_bookings_ibfk_1")
  cars             cars?                    @relation(fields: [car_id], references: [car_id], onDelete: NoAction, onUpdate: NoAction, map: "tourism_bookings_ibfk_2")

  @@index([car_id], map: "car_id")
  @@index([tour_id], map: "tour_id")
}

model tourismservices {
  tour_id          Int                @id
  description      String?            @db.Text
  total_price      Float?             @db.Float
  package_places   package_places[]
  packages         packages[]
  tourism_bookings tourism_bookings[]
}

model users {
  user_id                              Int                @id @default(autoincrement())
  name                                 String?            @db.VarChar(100)
  email                                String?            @db.VarChar(100)
  nationality                          String?            @db.VarChar(255)
  contact_info                         String?            @db.VarChar(255)
  role                                 users_role?
  action_history                       action_history[]
  chat_chat_user1_idTousers            chat[]             @relation("chat_user1_idTousers")
  chat_chat_user2_idTousers            chat[]             @relation("chat_user2_idTousers")
  login                                login[]
  messages_messages_sender_idTousers   messages[]         @relation("messages_sender_idTousers")
  messages_messages_receiver_idTousers messages[]         @relation("messages_receiver_idTousers")
  package_bookings                     package_bookings[]
  payment                              payment[]
  review_hospital                      review_hospital[]
  review_hotel                         review_hotel[]
  review_inter                         review_inter[]
}

model hospital_images {
  image_id    Int        @id @default(autoincrement())
  hospital_id Int?
  image       String?    @db.VarChar(255)
  hospitals   hospitals? @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction, map: "hospital_images_ibfk_1")

  @@index([hospital_id], map: "hospital_id")
}

model chat {
  chat_id                    Int        @id @default(autoincrement())
  user1_id                   Int
  user2_id                   Int
  timestamp                  DateTime   @default(now()) @db.Timestamp(0)
  users_chat_user1_idTousers users      @relation("chat_user1_idTousers", fields: [user1_id], references: [user_id], onUpdate: Restrict, map: "chat_ibfk_1")
  users_chat_user2_idTousers users      @relation("chat_user2_idTousers", fields: [user2_id], references: [user_id], onUpdate: Restrict, map: "chat_ibfk_2")
  messages                   messages[]

  @@index([user2_id], map: "user2_id")
  @@index([user1_id], map: "user_id")
}

