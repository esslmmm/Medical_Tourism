//--------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User --------------------------------

model User {
  id                                    Int       @id @default(autoincrement())
  name                                  String?
  email                                 String    @unique
  password                              String?
  image                                 String?
  role                                  String    @default("user") // Add a role field
  emailVerified                         DateTime?
  createdAt                             DateTime  @default(now())
  updatedAt                             DateTime  @updatedAt
  accounts                              Account[]
  action_histories                      Action_History[]
  chat_user1Id                          Chat[]             @relation("chat_user1_idTousers")
  chat_user2Id                          Chat[]             @relation("chat_user2_idTousers")
  messages_senderId                     Messages[]         @relation("messages_sender_idTousers")
  messages_receiverId                   Messages[]         @relation("messages_receiver_idTousers")
  package_bookings                      Package_Booking[]
  payments                              Payment[]
  hospital_reviews                      Hospital_Review[]
  hotel_reviews                         Hotel_Review[]
  interpreter_reviews                   Interpreter_Review[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Medical Provider --------------------------------

model Hospital {
  id               Int                @id @default(autoincrement())
  name             String?            @db.VarChar(100)
  hospital_code    String?            @db.VarChar(20)
  location         String?            @db.VarChar(255)
  city             String?            @db.VarChar(50)
  description      String?            @db.Text
  contact_info     String?            @db.VarChar(255)
  rating           Float?             @db.Float
  image            String?            @db.VarChar(255)
  logo             String             @db.VarChar(255)
  createAt        DateTime?          @default(now()) @db.Timestamp(3)
  doctors          Doctor[]
  hospital_images  Hospital_Image[]
  medical_services Medical_Service[]
  packages         Package[]
  hospital_reviews  Hospital_Review[]
}

model Hospital_Image {
  id            Int        @id @default(autoincrement())
  hospitalId    Int?
  image        String?    @db.VarChar(255)
  hospital      Hospital? @relation(fields: [hospitalId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "hospital_images_ibfk_1")

  @@index([hospitalId], map: "hospitalId")
}

model Hospital_Review {
  id    Int       @id @default(autoincrement())
  userId      Int
  hospitalId  Int
  rating       Float?    @db.Float
  review_title String?   @db.Text
  comment      String?   @db.Text
  createdAt   DateTime? @default(now()) @db.Timestamp(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "review_hospital_ibfk_1")
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "review_hospital_ibfk_2")

  @@index([hospitalId], map: "hospitalId")
  @@index([userId], map: "userId")
}

model Doctor {
  id       Int               @id @default(autoincrement())
  name            String?           @db.VarChar(255)
  specialization  String?           @db.VarChar(255)
  hospitalId     Int?
  experience      Int?
  description     String?           @db.VarChar(200)
  image           String?           @db.VarChar(255)
  createAt       DateTime?         @default(now())
  appointments    Appointment[]
  doctor_certificates Doctor_Certificate[]
  doctor_educations   Doctor_Education[]
  doctor_languages    Doctor_Language[]
  hospital       Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "doctors_ibfk_1")
  doctors_in_package     Doctor_In_Package[]

  @@index([hospitalId], map: "hospitalId")
}

model Doctor_Certificate {
  id Int      @id @default(autoincrement())
  doctorId      Int?
  field_of_study String?  @db.VarChar(255)
  institution    String?  @db.VarChar(255)
  year           Int?
  doctor        Doctor? @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "doc_certificate_ibfk_1")

  @@index([doctorId], map: "doctorId")
}

model Doctor_Education {
  id   Int      @id @default(autoincrement())
  doctorId      Int?
  field_of_study String?  @db.VarChar(255)
  institution    String?  @db.VarChar(255)
  year           Int?
  doctor        Doctor? @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "doc_education_ibfk_1")

  @@index([doctorId], map: "doctorId")
}

model Doctor_Language {
  id Int      @id @default(autoincrement())
  doctorId   Int?
  languages   String?  @db.VarChar(255)
  doctor     Doctor? @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "doc_language_ibfk_1")

  @@index([doctorId], map: "doctorId")
}

model Medical_Service {
  id   Int        @id @default(autoincrement())
  hospitalId  Int?
  service_name String?    @db.VarChar(255)
  description  String?    @db.VarChar(255)
  hospital    Hospital? @relation(fields: [hospitalId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "medical_services_ibfk_1")

  @@index([hospitalId], map: "hospitalId")
}

// Trip --------------------------------

model Trip {
  id          Int                @id @default(autoincrement())
  packageId       Int
  description      String?            @db.Text
  total_price      Float?             @db.Float
  places_in_trip   Place_In_Trip[]
  tourism_bookings Tourism_Booking[]
  package         Package           @relation(fields: [packageId], references: [id], onUpdate: Restrict, map: "trips_ibfk_1")

  @@index([packageId], map: "packageId")
}

model Place_In_Trip {
  id    Int       @id @default(autoincrement())
  tourId         Int?
  placeId        Int?
  date            DateTime? @db.Date
  start           DateTime? @db.Timestamp(0)
  end             DateTime? @db.Timestamp(0)
  tourismservice Trip?    @relation(fields: [tourId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_places_ibfk_1")
  place          Place?   @relation(fields: [placeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_places_ibfk_2")

  @@index([placeId], map: "placeId")
  @@index([tourId], map: "tourId")
}

model Place {
  id       Int              @id @default(autoincrement())
  place_name     String?          @db.VarChar(100)
  contact_info   String?          @db.VarChar(255)
  location       String?          @db.VarChar(255)
  city           String?          @db.VarChar(255)
  image          String?          @db.VarChar(255)
  description    String?          @db.Text
  fee            Float?           @db.Float
  package_places Place_In_Trip[]
  place_images    Place_Image[]
}

model Place_Image {
  id Int     @id @default(autoincrement())
  placeId Int?
  image    String? @db.VarChar(255)
  place   Place? @relation(fields: [placeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "place_image_ibfk_2")

  @@index([placeId], map: "PlaceId")
}

model Car {
  id           Int                @id @default(autoincrement())
  car_name         String?            @db.VarChar(50)
  phone            Int?
  email            String?            @db.VarChar(100)
  address          String?            @db.VarChar(255)
  city             String?            @db.VarChar(255)
  image            String?            @db.VarChar(255)
  description      String?            @db.Text
  fee              Float?             @db.Float
  capacity         Int?
  guide_license    String?            @db.VarChar(255)
  tourism_bookings Tourism_Booking[]
}

// Accommodataion --------------------------------

model Hotel {
  id         Int                @id @default(autoincrement())
  name             String?            @db.VarChar(255)
  hotel_code       String?            @db.VarChar(20)
  location         String?            @db.VarChar(255)
  city             String?            @db.VarChar(100)
  rating           Float?             @db.Float
  email            String?            @db.VarChar(50)
  description      String?            @db.Text
  image            String?            @db.VarChar(255)
  contact_info     String?            @db.VarChar(255)
  create_at        DateTime           @default(now()) @db.Timestamp(0)
  hotel_bookings   Hotel_Booking[]
  hotel_facilities Hotel_Facility[]
  hotel_images     Hotel_Image[]
  hotel_rooms      Room_In_Hotel[]
  package_hotels   Package_Hotel[]
  review_hotel     Hotel_Review[]
}

model Hotel_Image {
  id Int     @id @default(autoincrement())
  hotelId Int?
  image    String? @db.VarChar(255)
  hotel   Hotel? @relation(fields: [hotelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_images_ibfk_1")

  @@index([hotelId], map: "hotelId")
}

model Hotel_Facility {
  id   Int     @id @default(autoincrement())
  hotelId      Int?
  facility_name String? @db.VarChar(100)
  description   String? @db.Text
  hotel        Hotel? @relation(fields: [hotelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_facilities_ibfk_1")

  @@index([hotelId], map: "hotelId")
}

model Room_In_Hotel {
  id               Int                     @id @default(autoincrement())
  hotelId              Int?
  room_type             String?                 @db.VarChar(100)
  price_per_night       Float?                  @db.Float
  capacity              String?                 @db.VarChar(200)
  description           String?                 @db.Text
  image                 String?                 @db.VarChar(255)
  hotel_room_facilities Room_Facility[]
  hotel                Hotel?                 @relation(fields: [hotelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_rooms_ibfk_1")
  room_aggregates        Room_Aggregate[]
  room_images            Room_Image[]

  @@index([hotelId], map: "hotelId")
}



model Room_Facility {
  id Int          @id @default(autoincrement())
  roomId           Int?
  facility_name     String?      @db.VarChar(100)
  description       String?      @db.Text
  hotel_rooms       Room_In_Hotel? @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_room_facilities_ibfk_1")

  @@index([roomId], map: "roomId")
}

model Room_Aggregate {
  id   Int             @id @default(autoincrement())
  roomId        Int?
  bookingId     Int?
  amount         Int
  hotel_room    Room_In_Hotel?    @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "room_aggregate_ibfk_1")
  hotel_booking Hotel_Booking? @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "room_aggregate_ibfk_2")

  @@index([bookingId], map: "booking_id")
  @@index([roomId], map: "roomId")
}

model Room_Image {
  image_id    Int          @id @default(autoincrement())
  roomId     Int?
  image       String?      @db.VarChar(255)
  hotel_room Room_In_Hotel? @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "room_image_ibfk_1")

  @@index([roomId], map: "roomId")
}

model Hotel_Review {
  id    Int       @id @default(autoincrement())
  userId      Int
  hotelId     Int
  rating       Float?    @db.Float
  title_review String?   @db.Text
  comment      String?   @db.Text
  createdAt   DateTime? @default(now()) @db.Timestamp(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "review_hotel_ibfk_1")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "review_hotel_ibfk_2")

  @@index([hotelId], map: "hotelId")
  @@index([userId], map: "userId")
}

// Interpreter --------------------------------

model Interpreter {
  id       Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  email                String                 @unique(map: "email") @db.VarChar(255)
  phone                String                 @db.VarChar(50)
  rating               Float                  @db.Float
  nationality          String                 @db.VarChar(100)
  image                String                 @db.VarChar(255)
  birthofday           DateTime               @db.Date
  experience           DateTime               @default(dbgenerated("('2025-02-02')")) @db.Date
  address              String                 @db.Text
  profile_summary      String                 @db.Text
  native_language      Native_Language
  createAt            DateTime               @default(now()) @db.Timestamp(0)
  interpreter_bookings       Interpreter_Booking[]
  interpreter_educaitons      Interpreter_Education[]
  languages            Language[]
  package_interpreters Package_Interpreter[]
  interpreter_reviews         Interpreter_Review[]
}

enum Native_Language {
  English
  Arabic
  Burmese
}

model Language {
  id        Int                    @id @default(autoincrement())
  interpreterId Int?
  language_name  String?                @db.VarChar(100)
  proficiency    Language_Proficiency?
  interpreters   Interpreter?          @relation(fields: [interpreterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "languages_ibfk_1")

  @@index([interpreterId], map: "interpreterId")
}

enum Language_Proficiency {
  Basic
  Conversational
  Fluent
  Native
}

model Interpreter_Education {
  id   Int           @id @default(autoincrement())
  interpreterId Int?
  degree         String?       @db.VarChar(50)
  field_of_study String?       @db.VarChar(255)
  institution    String?       @db.VarChar(100)
  interpreters   Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inter_education_ibfk_1")

  @@index([interpreterId], map: "interpreterId")
}

model Interpreter_Review {
  id      Int          @id @default(autoincrement())
  userId        Int
  interpreterId Int
  rating         Float?       @db.Float
  title_review   String?      @db.Text
  comment        String?      @db.Text
  createdAt     DateTime?    @default(now()) @db.Timestamp(0)
  users          User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "review_inter_ibfk_1")
  interpreters   Interpreter @relation(fields: [interpreterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "review_inter_ibfk_2")

  @@index([interpreterId], map: "interpreterId")
  @@index([userId], map: "userId")
}


// Package --------------------------------

model Package {
  id           Int                    @id @default(autoincrement())
  package_name         String                 @db.VarChar(255)
  package_type         Package_Type
  hospitalId          Int
  image                String                 @db.VarChar(255)
  detail               String                 @db.VarChar(100)
  duration             Int
  expired_date         DateTime               @db.Date
  create_at            DateTime               @default(now()) @db.Timestamp(0)
  descriptions          Package_Description[]
  package_bookings     Package_Booking[]
  package_doctors          Doctor_In_Package[]
  package_hotels       Package_Hotel[]
  package_images        Package_Image[]
  package_interpreters Package_Interpreter[]
  hospital            Hospital              @relation(fields: [hospitalId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "packages_ibfk_1")
  trips                Trip[]

  @@index([hospitalId], map: "hospitalId")
}

enum Package_Type {
  Medical_Tourism      @map("Medical&Tourism")
  Medical_Service_Only @map("Medical Service Only")
}

model Package_Description {
  id Int       @id @default(autoincrement())
  packageId     Int?
  details        String?   @db.VarChar(255)
  packages       Package? @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "description_ibfk_1")

  @@index([packageId], map: "packageId")
}

model Package_Image {
  id   Int       @id @default(autoincrement())
  packageId Int?
  images     String?   @db.VarChar(255)
  packages   Package? @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_image_ibfk_1")

  @@index([packageId], map: "packageId")
}

model Doctor_In_Package {
  id     Int       @id @default(autoincrement())
  packageId Int?
  doctorId  Int?
  packages   Package? @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_doc_ibfk_1")
  doctors    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_doc_ibfk_2")

  @@index([doctorId], map: "doctorId")
  @@index([packageId], map: "packageId")
}

model Package_Hotel {
  id Int       @id @default(autoincrement())
  packageId   Int?
  hotelId     Int?
  package     Package? @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_hotels_ibfk_1")
  hotel       Hotel?   @relation(fields: [hotelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_hotels_ibfk_2")

  @@index([hotelId], map: "hotelId")
  @@index([packageId], map: "packageId")
}

model Package_Interpreter {
  id       Int           @id @default(autoincrement())
  packageId     Int?
  interpreterId Int?
  packages       Package?     @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_interpreters_ibfk_1")
  interpreters   Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_interpreters_ibfk_2")

  @@index([interpreterId], map: "interpreterId")
  @@index([packageId], map: "packageId")
}

// Booking --------------------------------

model Package_Booking {
  id         Int                     @id @default(autoincrement())
  userId            Int
  packageId         Int
  tourism_bookingId Int
  appointmentId     Int
  hotel_bookingId   Int
  user_contactId         Int
  interpreter_bookingId   Int
  createAt          DateTime                @default(now()) @db.Timestamp(0)
  status             Package_Bookings_Status
  user              User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_1")
  package           Package                @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_2")
  tourism_booking   Tourism_Booking        @relation(fields: [tourism_bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_3")
  appointment       Appointment            @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_4")
  hotel_booking     Hotel_Booking          @relation(fields: [hotel_bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_5")
  use_contact_detail    User_Contact_Detail         @relation(fields: [user_contactId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_6")
  interpreter_booking     Interpreter_Booking          @relation(fields: [interpreter_bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "package_bookings_ibfk_7")
  payments            Payment[]

  @@index([appointmentId], map: "appointmentId")
  @@index([user_contactId], map: "userContactId")
  @@index([hotel_bookingId], map: "hotelBookingId")
  @@index([interpreter_bookingId], map: "InterpreterBookingId")
  @@index([packageId], map: "packageId")
  @@index([tourism_bookingId], map: "tourismBookingId")
  @@index([userId], map: "userId")
}

enum Package_Bookings_Status {
  Pending
  Approved
  Completed
  Rejected
  Cancelled
}

// Appointment --------------------------------

model Appointment {
  id   Int                @id @default(autoincrement())
  date             DateTime?          @db.Date
  timeslot         String?            @db.VarChar(255)
  patientId       Int?
  description      String?            @db.Text
  doctorId        Int?
  file_name        String?            @db.VarChar(255)
  file_path        String?            @db.VarChar(255)
  upload_date      DateTime?          @db.Timestamp(0)
  patient_detail  Patient_Detail?   @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "appointments_ibfk_1")
  doctor          Doctor?           @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "appointments_ibfk_2")
  package_bookings Package_Booking[]

  @@index([doctorId], map: "doctorId")
  @@index([patientId], map: "patientId")
}

// Tourism Booking --------------------------------
model Tourism_Booking {
  id       Int                      @id @default(autoincrement())
  tripId          Int?
  carId           Int?
  status           Tourism_Booking_Status?
  package_bookings Package_Booking[]
  tourismservice  Trip?                   @relation(fields: [tripId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tourism_bookings_ibfk_1")
  car             Car?                    @relation(fields: [carId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tourism_bookings_ibfk_2")

  @@index([carId], map: "carId")
  @@index([tripId], map: "tripId")
}

enum Tourism_Booking_Status {
  Pending
  Approved
  Rejected
}

// Hotel_Booking --------------------------------

model Hotel_Booking {
  id       Int                    @id @default(autoincrement())
  hotelId         Int?
  check_in_date    DateTime?              @db.Date
  check_out_date   DateTime?              @db.Date
  guest_children   Int?
  guest_adult      Int?
  total_price      Float?                 @db.Float
  status           Hotel_Booking_Status?
  hotel           Hotel?                @relation(fields: [hotelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "hotel_bookings_ibfk_1")
  package_bookings Package_Booking[]
  room_aggregate   Room_Aggregate[]

  @@index([hotelId], map: "hotelId")
}

enum Hotel_Booking_Status {
  Pending
  Approved
  Rejected
  Cancelled
}

// Interpreter Booking --------------------------------

model Interpreter_Booking {
  id       Int                    @id @default(autoincrement())
  interpreterId   Int?
  start            DateTime?              @db.Date
  end              DateTime?              @db.Date
  status           Interpreter_Booking_Status?
  interpreter     Interpreter?          @relation(fields: [interpreterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "inter_bookings_ibfk_1")
  package_bookings Package_Booking[]

  @@index([interpreterId], map: "interpreterId")
}

enum Interpreter_Booking_Status {
  Pending
  Approved
  Rejected
  Cancelled
}

// Payment --------------------------------

model Payment {
  id       Int                    @id @default(autoincrement())
  userId          Int
  bookingId       Int
  payment_date     DateTime               @db.DateTime(0)
  payment_method   String                 @db.VarChar(255)
  amount           Decimal                @db.Decimal(10, 0)
  payment_status   Payment_Payment_Status
  transaction_id   String                 @db.VarChar(50)
  user            User                  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_ibfk_1")
  package_booking Package_Booking       @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_ibfk_2")

  @@index([bookingId], map: "bookingId")
  @@index([userId], map: "uer_id")
}

enum Payment_Payment_Status {
  successful
  Failed
  Peding
  Refund
}

// User Booking Detail --------------------------------

model User_Contact_Detail {
  id       Int                @id @default(autoincrement())
  firstname        String?            @db.VarChar(255)
  lastname         String?            @db.VarChar(255)
  email            String?            @db.VarChar(255)
  country          String?            @db.VarChar(255)
  phone            Int?
  package_bookings Package_Booking[]
}
model Patient_Detail {
  id      Int                     @id @default(autoincrement())
  firstname       String?                 @db.VarChar(255)
  lastname        String?                 @db.VarChar(255)
  gender          Patient_Details_Gender?
  dateofbirth     DateTime?               @db.Date
  nationality     String?                 @db.VarChar(255)
  passport_number String?                 @db.VarChar(255)
  appointments    Appointment[]
}


enum Patient_Details_Gender {
  Male
  Female
}

// History --------------------------------

model Action_History {
  id   Int                         @id @default(autoincrement())
  userId     Int
  type_action Action_History_Type_Action?
  timestamp   DateTime?                   @db.Timestamp(0)
  action      String?                     @db.VarChar(255)
  objectId          Int?
  user        User                       @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "action_history_ibfk_1")

  @@index([userId], map: "userId")
}

enum Action_History_Type_Action {
   Add
   Remove
   Update
 }

// Chat --------------------------------

model Chat {
  id                    Int        @id @default(autoincrement())
  user1Id                   Int
  user2Id                   Int
  timestamp                  DateTime   @default(now()) @db.Timestamp(0)
  users_chat_user1_idTousers User       @relation("chat_user1_idTousers", fields: [user1Id], references: [id], onUpdate: Restrict, map: "chat_ibfk_1")
  users_chat_user2_idTousers User       @relation("chat_user2_idTousers", fields: [user2Id], references: [id], onUpdate: Restrict, map: "chat_ibfk_2")
  messages                   Messages[]

  @@index([user2Id], map: "user2Id")
  @@index([user1Id], map: "user1Id")
}

model Messages {
  message_id                        Int       @id @default(autoincrement())
  chatId                           Int
  senderId                         Int?
  receiverId                       Int?
  message                           String?   @db.Text
  timestamp                         DateTime? @default(now()) @db.Timestamp(0)
  users_messages_sender_idTousers   User?     @relation("messages_sender_idTousers", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "messages_ibfk_1")
  users_messages_receiver_idTousers User?     @relation("messages_receiver_idTousers", fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "messages_ibfk_2")
  chat                              Chat      @relation(fields: [chatId], references: [id], onUpdate: Restrict, map: "messages_ibfk_3")

  @@index([receiverId], map: "receiverId")
  @@index([senderId], map: "senderId")
  @@index([chatId], map: "chatId")
}

//-----------------------------------

model Contact_Us{
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String  @unique
  phoneNumber String
  country     String
  type        String
  message     String
  createdAt   DateTime @default(now())
}
