generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model action_history {
  id          Int?
  type_action action_history_type_action?
  timestamp   DateTime?                   @db.Timestamp(0)
  action      String?                     @db.VarChar(255)
  action_id   Int                         @id @default(autoincrement())
  user_id     Int
  user        user                        @relation(fields: [user_id], references: [id], onUpdate: Restrict)

  @@index([user_id])
}

model File {
  id                String            @id @default(uuid())
  userId            Int
  originalName      String
  fileName          String
  fileType          String
  fileSize          Int
  cloudinaryId      String
  url               String
  uploadedAt        DateTime          @default(now())
  category          FileCategory
  description       String?
  appointment_files AppointmentFile[]
  user              user              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("files")
}

model AppointmentFile {
  id            Int          @id @default(autoincrement())
  appointmentId String
  fileId        String
  createdAt     DateTime     @default(now())
  appointments  appointments @relation(fields: [appointmentId], references: [appointment_id], onDelete: Cascade)
  files         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([fileId])
  @@map("appointment_files")
}

model appointments {
  appointment_id    String              @id @default(uuid())
  date              DateTime?           @db.Date
  timeslot          String?             @db.VarChar(255)
  patient_id        Int?
  description       String?
  status            appointments_status @default(In_Progress)
  appointment_files AppointmentFile[]
  patient_details   patient_details?    @relation(fields: [patient_id], references: [patient_id], onDelete: NoAction, onUpdate: NoAction, map: "appointments_ibfk_1")
  package_bookings  package_bookings[]

  @@index([patient_id])
}

model description {
  description_id Int      @id @default(autoincrement())
  package_id     String
  details        String   @db.VarChar(255)
  title          String   @db.VarChar(100)
  packages       packages @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction, map: "description_ibfk_1")

  @@index([package_id], map: "package_id")
}

model doc_certificate {
  cerfiticate_id Int      @id @default(autoincrement())
  doctor_id      String?
  field_of_study String?  @db.VarChar(255)
  institution    String?  @db.VarChar(255)
  year           Int?
  doctors        doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_certificate_ibfk_1")

  @@index([doctor_id])
}

model doc_education {
  education_id   Int      @id @default(autoincrement())
  doctor_id      String?
  field_of_study String?  @db.VarChar(255)
  institution    String?  @db.VarChar(255)
  year           Int?
  doctors        doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_education_ibfk_1")

  @@index([doctor_id])
}

model doc_language {
  language_id Int      @id @default(autoincrement())
  doctor_id   String?
  languages   String?  @db.VarChar(255)
  doctors     doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_language_ibfk_1")

  @@index([doctor_id], map: "doctor_id")
}

model doctors {
  doctor_id       String            @id @default(uuid())
  name            String?           @db.VarChar(255)
  specialization  String?           @db.VarChar(255)
  hospital_id     String?
  experience      Int?
  description     String?           @db.VarChar(200)
  image           String?           @db.VarChar(255)
  create_at       DateTime?         @default(now())
  doc_certificate doc_certificate[]
  doc_education   doc_education[]
  doc_language    doc_language[]
  hospitals       hospitals?        @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction, map: "doctors_ibfk_1")
  package_doc     package_doc[]

  @@index([hospital_id], map: "hospital_id")
}

model hospitals {
  hospital_id      String             @id @default(uuid())
  name             String?            @db.VarChar(100)
  hospital_code    String?            @db.VarChar(20)
  location         String?            @db.VarChar(255)
  city             String?            @db.VarChar(50)
  description      String?
  contact_info     String?            @db.VarChar(255)
  rating           Float?
  image            String?            @db.VarChar(255)
  logo             String             @db.VarChar(255)
  create_at        DateTime?          @default(now())
  doctors          doctors[]
  hospital_images  hospital_images[]
  medical_services medical_services[]
  packages         packages[]
  review_hospital  review_hospital[]
}

model hotel_bookings {
  booking_id       Int                    @id @default(autoincrement())
  hotel_id         Int?
  check_in_date    DateTime?              @db.Date
  check_out_date   DateTime?              @db.Date
  guest_children   Int?
  guest_adult      Int?
  total_price      Float?
  status           hotel_bookings_status? @default(In_Progress)
  created_at       DateTime               @default(now()) @db.Timestamp(0)
  updated_at       DateTime               @default(now()) @db.Timestamp(0)
  hotels           hotels?                @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)
  package_bookings package_bookings[]
  room_aggregate   room_aggregate[]

  @@index([hotel_id])
}

model hotel_facilities {
  facility_id   Int     @id @default(autoincrement())
  hotel_id      Int?
  facility_name String? @db.VarChar(100)
  description   String?
  hotels        hotels? @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hotel_id])
}

model hotel_images {
  image_id Int     @id @default(autoincrement())
  hotel_id Int?
  image    String? @db.VarChar(255)
  hotels   hotels? @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hotel_id])
}

model hotel_room_facilities {
  room_facilitiy_id Int          @id @default(autoincrement())
  room_id           Int?
  facility_name     String?      @db.VarChar(100)
  description       String?
  hotel_rooms       hotel_rooms? @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([room_id])
}

model hotel_rooms {
  room_id               Int                     @id @default(autoincrement())
  hotel_id              Int?
  room_type             String?                 @db.VarChar(100)
  price_per_night       Float?
  capacity              String?                 @db.VarChar(200)
  description           String?
  image                 String?                 @db.VarChar(255)
  hotel_room_facilities hotel_room_facilities[]
  hotels                hotels?                 @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)
  room_aggregate        room_aggregate[]
  room_image            room_image[]

  @@index([hotel_id])
}

model hotels {
  hotel_id         Int                @id @default(autoincrement())
  name             String?            @db.VarChar(255)
  hotel_code       String?            @db.VarChar(20)
  location         String?            @db.VarChar(255)
  city             String?            @db.VarChar(100)
  rating           Float?
  email            String?            @db.VarChar(50)
  description      String?
  image            String?            @db.VarChar(255)
  check_in_time    String             @default("1 PM") @db.VarChar(10)
  contact_info     String?            @db.VarChar(255)
  create_at        DateTime           @default(now()) @db.Timestamp(0)
  hotel_bookings   hotel_bookings[]
  hotel_facilities hotel_facilities[]
  hotel_images     hotel_images[]
  hotel_rooms      hotel_rooms[]
  package_hotels   package_hotels[]
  review_hotel     review_hotel[]
}

model guide_bookings {
  booking_id       Int                    @id @default(autoincrement())
  guide_id   Int?
  start            DateTime?              @db.Date
  end              DateTime?              @db.Date
  status           guide_bookings_status? @default(In_Progress)
  created_at       DateTime               @default(now()) @db.Timestamp(0)
  updated_at       DateTime               @default(now()) @db.Timestamp(0)
  guides           guides?          @relation(fields: [guide_id], references: [guide_id], onDelete: NoAction, onUpdate: NoAction)
  package_bookings package_bookings[]

  @@index([guide_id])
}

model guide_education {
  education_id   Int           @id @default(autoincrement())
  guide_id Int?
  degree         String?       @db.VarChar(50)
  field_of_study String?       @db.VarChar(255)
  institution    String?       @db.VarChar(100)
  guides   guides? @relation(fields: [guide_id], references: [guide_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([guide_id])
}

model guides {
  guide_id       Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  email                String                 @db.VarChar(255)
  phone                String                 @db.VarChar(50)
  rating               Float
  nationality          String                 @db.VarChar(100)
  image                String                 @db.VarChar(255)
  birthofday           DateTime               @db.Date
  experience           DateTime               @default(dbgenerated("'2025-02-02'::date")) @db.Date
  address              String
  profile_summary      String
  language             guides_language
  create_at            DateTime               @default(now()) @db.Timestamp(0)
  guide_bookings       guide_bookings[]
  guide_education      guide_education[]
  languages            languages[]
  package_guides       package_guides[]
  review_guide         review_guide[]
}

model languages {
  lang_id        Int                    @id @default(autoincrement())
  guide_id       Int?
  language_name  String?                @db.VarChar(100)
  proficiency    languages_proficiency?
  guides         guides?          @relation(fields: [guide_id], references: [guide_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([guide_id])
}

model medical_services {
  service_id   Int        @id @default(autoincrement())
  hospital_id  String?
  service_name String?    @db.VarChar(255)
  description  String?    @db.VarChar(255)
  hospitals    hospitals? @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hospital_id])
}

model messages {
  message_id                      Int       @id @default(autoincrement())
  message                         String
  message_type                    MessageType @default(TEXT)
  file_url                        String?
  file_name                       String?
  file_size                       Int?
  file_type                       String?
  timestamp                       DateTime? @default(now()) @db.Timestamp(0)
  chat_id                         Int
  sender_id                       Int

  chat                            chat      @relation(fields: [chat_id], references: [chat_id], onUpdate: Restrict)
  user_messages_sender_idTouser   user?     @relation("messages_sender_idTouser", fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sender_id])
  @@index([chat_id])
  @@index([chat_id, timestamp])              // Most important for loading messages
  
  @@map("messages")
}

model package_bookings {
  booking_id          String                  @id @default(uuid())
  user_id             Int
  package_id          String
  tourism_booking_id  String?
  appointment_id      String?
  hotel_booking_id    Int?
  contact_id          String?
  guide_booking_id    Int?
  create_at           DateTime                @default(now()) @db.Timestamp(0)
  status              package_bookings_status @default(In_Progress)
  appointments        appointments?           @relation(fields: [appointment_id], references: [appointment_id], onDelete: NoAction, onUpdate: NoAction)
  user_contact_detail user_contact_detail?    @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hotel_bookings      hotel_bookings?         @relation(fields: [hotel_booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction)
  guide_bookings      guide_bookings?         @relation(fields: [guide_booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction)
  packages            packages                @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction)
  tourism_bookings    tourism_bookings?       @relation(fields: [tourism_booking_id], references: [tourism_id], onDelete: NoAction, onUpdate: NoAction)
  user                user                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment             payment[]

  @@index([user_id])
  @@index([package_id])
  @@index([tourism_booking_id])
  @@index([appointment_id])
  @@index([hotel_booking_id])
  @@index([contact_id])
  @@index([guide_booking_id])
}

model package_doc {
  doc_id     Int       @id @default(autoincrement())
  package_id String?
  doctor_id  String?
  doctors    doctors?  @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction)
  packages   packages? @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([package_id])
  @@index([doctor_id])
}

model package_hotels {
  packhotel_id Int       @id @default(autoincrement())
  package_id   String?
  hotel_id     Int?
  hotels       hotels?   @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)
  packages     packages? @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([package_id])
  @@index([hotel_id])
}

model package_image {
  images     String?   @db.VarChar(255)
  image_id   Int       @id @default(autoincrement())
  package_id String?
  detail     String
  title      String
  packages   packages? @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([package_id])
}

model package_guides {
  pack_guide_id    Int           @id @default(autoincrement())
  package_id       String?
  guide_id         Int?
  guides           guides? @relation(fields: [guide_id], references: [guide_id], onDelete: NoAction, onUpdate: NoAction)
  packages        packages?     @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([package_id])
  @@index([guide_id])
}

model package_places {
  packplace_id Int     @id @default(autoincrement())
  tour_id      Int?
  place_id     String?
  places       places? @relation(fields: [place_id], references: [place_id], onDelete: NoAction, onUpdate: NoAction)
  trips        trips?  @relation(fields: [tour_id], references: [tour_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tour_id])
  @@index([place_id])
}

model packages {
  package_id           String                 @id @default(uuid())
  package_name         String                 @db.VarChar(255)
  hospital_id          String
  image                String                 @db.VarChar(255)
  detail               String                 @db.VarChar(100)
  duration             Int
  expired_date         DateTime               @db.Date
  create_at            DateTime               @default(now()) @db.Timestamp(0)
  description          description[]
  package_bookings     package_bookings[]
  package_doc          package_doc[]
  package_hotels       package_hotels[]
  package_image        package_image[]
  package_guides       package_guides[]
  hospitals            hospitals              @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction)
  routes               routes[]

  @@index([hospital_id])
}

model payment {
  payment_date     DateTime
  payment_method   String                 @db.VarChar(255)
  amount           Decimal                @db.Decimal(10, 0)
  payment_status   payment_payment_status
  transaction_id   String                 @db.VarChar(50)
  booking_id       String
  payment_id       String                 @id @default(uuid())
  user_id          Int
  package_bookings package_bookings       @relation(fields: [booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction)
  user             user                   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([booking_id])
}

model place_image {
  image    String? @db.VarChar(255)
  image_id Int     @id @default(autoincrement())
  place_id String?
  places   places? @relation(fields: [place_id], references: [place_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([place_id])
}

model places {
  place_id       String           @id @default(uuid())
  place_name     String?          @db.VarChar(100)
  contact_info   String?          @db.VarChar(255)
  location       String?          @db.VarChar(255)
  city           String?          @db.VarChar(255)
  image          String?          @db.VarChar(255)
  description    String?
  fee            Float?
  package_places package_places[]
  place_image    place_image[]
}

model review_hospital {
  review_id    Int       @id @default(autoincrement())
  user_id      Int
  hospital_id  String
  rating       Float?
  title_review String?
  comment      String?
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  hospitals    hospitals @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction)
  user         user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([hospital_id])
}

model review_hotel {
  review_id    Int       @id @default(autoincrement())
  user_id      Int
  hotel_id     Int
  rating       Float?
  title_review String?
  comment      String?
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  hotels       hotels    @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)
  user         user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([hotel_id])
}

model review_guide {
  review_id      Int          @id @default(autoincrement())
  user_id        Int
  guide_id       Int
  rating         Float?
  title_review   String?
  comment        String?
  created_at     DateTime?    @default(now()) @db.Timestamp(0)
  guides         guides @relation(fields: [guide_id], references: [guide_id], onDelete: NoAction)
  user           user         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([guide_id])
}

model room_aggregate {
  amount         Int
  aggregate_id   Int             @id @default(autoincrement())
  booking_id     Int?
  room_id        Int?
  hotel_bookings hotel_bookings? @relation(fields: [booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction)
  hotel_rooms    hotel_rooms?    @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([room_id])
  @@index([booking_id])
}

model room_image {
  image_id    Int          @id @default(autoincrement())
  image       String?      @db.VarChar(255)
  room_id     Int?
  hotel_rooms hotel_rooms? @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([room_id])
}

model tourism_bookings {
  tourism_id       String                   @id @default(uuid())
  tour_id          Int                      
  status           tourism_bookings_status? @default(In_Progress)
  created_at       DateTime                 @default(now()) @db.Timestamp(0)
  updated_at       DateTime                 @default(now()) @db.Timestamp(0)
  package_bookings package_bookings[]
  routes           routes                   @relation(fields: [tour_id], references: [tour_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tour_id])
}

model hospital_images {
  image_id    Int        @id @default(autoincrement())
  hospital_id String
  image       String    @db.VarChar(255)
  hospitals   hospitals? @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hospital_id])
}

model chat {
  chat_id                  Int        @id @default(autoincrement())
  topic                    String
  customerId               Int
  staffId                  Int?
  timestamp                DateTime   @default(now()) @db.Timestamp(0)
  user_chat_user1_idTouser user       @relation("chat_user1_idTouser", fields: [customerId], references: [id], onUpdate: Restrict)
  user_chat_user2_idTouser user?      @relation("chat_user2_idTouser", fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages                 messages[]

  @@index([customerId])
  @@index([staffId])
}

model patient_details {
  patient_id      Int                     @id @default(autoincrement())
  firstname       String?                 @db.VarChar(255)
  lastname        String?                 @db.VarChar(255)
  gender          patient_details_gender?
  dateofbirth     DateTime?               @db.Date
  nationality     String?                 @db.VarChar(255)
  passport_number String?                 @db.VarChar(255)
  appointments    appointments[]
}

model trips {
  tour_id          Int                @id @default(autoincrement())
  description      String?
  total_price      Float?
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  package_places   package_places[]
  routes           routes[]
}

model routes {
  route_id      Int @id @default(autoincrement())
  package_id    String
  tour_id       Int             @unique
  trips         trips           @relation(fields: [tour_id], references: [tour_id], onUpdate: Restrict)
  packages      packages?           @relation(fields: [package_id], references: [package_id], onUpdate: Restrict)
  tourism_bookings tourism_bookings[]

  @@index([package_id])
  @@index([tour_id])
}

model contact_us {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String   @unique(map: "Contact_Us_email_key")
  phoneNumber String
  country     String
  type        String
  message     String
  createdAt   DateTime @default(now())
}

model user {
  id                                  Int                @id @default(autoincrement())
  name                                String?
  email                               String             @db.VarChar(255)
  nationality                         String?            @db.VarChar(255)
  password                            String?
  image                               String?            @db.VarChar(2048)
  role                                user_role          @default(customer)
  otp                                 String?            @db.VarChar(10)
  otp_expiry                          DateTime?
  is_email_verified                   Boolean            @default(false)
  createdAt                           DateTime           @default(now())
  updatedAt                           DateTime           @updatedAt
  account                             account[]
  action_history                      action_history[]
  chat_chat_user1_idTouser            chat[]             @relation("chat_user1_idTouser")
  chat_chat_user2_idTouser            chat[]             @relation("chat_user2_idTouser")
  files                               File[]
  messages_messages_sender_idTouser   messages[]         @relation("messages_sender_idTouser")
  package_bookings                    package_bookings[]
  payment                             payment[]
  review_hospital                     review_hospital[]
  review_hotel                        review_hotel[]
  review_guide                        review_guide[]
}

model user_contact_detail {
  id               String             @id @default(uuid())
  firstname        String?            @db.VarChar(255)
  lastname         String?            @db.VarChar(255)
  email            String?            @db.VarChar(255)
  country          String?            @db.VarChar(255)
  phone            Int?
  package_bookings package_bookings[]
}

model account {
  id                String  @id
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

enum action_history_type_action {
  Add
  Remove
  Update
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
  
  @@map("message_type")
}

enum languages_proficiency {
  Basic
  Conversational
  Fluent
  Native
}

enum payment_payment_status {
  successful
  Failed
  Peding
  Refund
}

enum guides_language {
  English
  Arabic
  Burmese
}

enum patient_details_gender {
  Male
  Female
}

enum user_role {
  customer
  staff
  admin
}

