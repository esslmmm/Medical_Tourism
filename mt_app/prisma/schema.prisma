generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model action_history {
  id          Int?
  type_action action_history_type_action?
  timestamp   DateTime?                   @db.Timestamp(0)
  action      String?                     @db.VarChar(255)
  action_id   Int                         @id @default(autoincrement())
  user_id     Int
  user        user                        @relation(fields: [user_id], references: [id], onUpdate: Restrict)

  @@index([user_id])
}

model File {
  id                String            @id @default(uuid())
  userId            Int
  originalName      String
  fileName          String
  fileType          String
  fileSize          Int
  cloudinaryId      String
  url               String
  uploadedAt        DateTime          @default(now())
  category          FileCategory
  description       String?
  appointment_files AppointmentFile[]
  user              user              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("files")
}

model AppointmentFile {
  id            Int          @id @default(autoincrement())
  appointmentId String
  fileId        String
  createdAt     DateTime     @default(now())
  appointments  appointments @relation(fields: [appointmentId], references: [appointment_id], onDelete: Cascade)
  files         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([fileId])
  @@map("appointment_files")
}

model appointments {
  appointment_id    String              @id @default(uuid())
  date              DateTime?           @db.Date
  timeslot          String?             @db.VarChar(255)
  description       String?
  child             Int
  adult             Int
  status            appointments_status @default(In_Progress)
  appointment_files AppointmentFile[]
  patient_details   patient_details[]
  package_bookings  package_bookings[]
}

model description {
  description_id Int      @id @default(autoincrement())
  package_id     String
  text           String
  packages       packages @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction, map: "description_ibfk_1")

  @@index([package_id], map: "package_id")
}

model doc_certificate {
  cerfiticate_id Int      @id @default(autoincrement())
  doctor_id      String?
  field_of_study String?  @db.VarChar(255)
  institution    String?  @db.VarChar(255)
  year           Int?
  doctors        doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_certificate_ibfk_1")

  @@index([doctor_id])
}

model doc_education {
  education_id   Int      @id @default(autoincrement())
  doctor_id      String?
  field_of_study String?  @db.VarChar(255)
  institution    String?  @db.VarChar(255)
  year           Int?
  doctors        doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_education_ibfk_1")

  @@index([doctor_id])
}

model doc_language {
  language_id Int      @id @default(autoincrement())
  doctor_id   String?
  languages   String?  @db.VarChar(255)
  doctors     doctors? @relation(fields: [doctor_id], references: [doctor_id], onDelete: NoAction, onUpdate: NoAction, map: "doc_language_ibfk_1")

  @@index([doctor_id], map: "doctor_id")
}

model doctors {
  doctor_id       String            @id @default(uuid())
  name            String?           @db.VarChar(255)
  specialization  String?           @db.VarChar(255)
  hospital_id     String?
  experience      Int?
  description     String?           @db.VarChar(200)
  image           String?           @db.VarChar(255)
  create_at       DateTime?         @default(now())
  doc_certificate doc_certificate[]
  doc_education   doc_education[]
  doc_language    doc_language[]
  hospitals       hospitals?        @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction, map: "doctors_ibfk_1")

  @@index([hospital_id], map: "hospital_id")
}

model hospitals {
  hospital_id      String             @id @default(uuid())
  name             String?            @db.VarChar(100)
  hospital_code    String?            @db.VarChar(20)
  location         String?            @db.VarChar(255)
  city             String?            @db.VarChar(50)
  description      String?
  contact_info     String?            @db.VarChar(255)
  rating           Float?
  image            String?            @db.VarChar(255)
  logo             String             @db.VarChar(255)
  Thai             Boolean
  Arabic           Boolean
  Myanmar          Boolean
  English          Boolean
  create_at        DateTime?          @default(now())
  doctors          doctors[]
  hospital_images  hospital_images[]
  medical_services medical_services[]
  packages         packages[]
  review_hospital  review_hospital[]
}


model guide_bookings {
  booking_id       Int                    @id @default(autoincrement())
  language         guide_languages
  start            DateTime?              @db.Date
  end              DateTime?              @db.Date
  status           guide_bookings_status? @default(In_Progress)
  created_at       DateTime               @default(now()) @db.Timestamp(0)
  updated_at       DateTime               @default(now()) @db.Timestamp(0)
  tourism_bookings tourism_bookings[]
}

model medical_services {
  service_id   Int        @id @default(autoincrement())
  hospital_id  String?
  service_name String?    @db.VarChar(255)
  description  String?    @db.VarChar(255)
  hospitals    hospitals? @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hospital_id])
}

model messages {
  message_id                      Int       @id @default(autoincrement())
  message                         String
  message_type                    MessageType @default(TEXT)
  file_url                        String?
  file_name                       String?
  file_size                       Int?
  file_type                       String?
  timestamp                       DateTime? @default(now()) @db.Timestamp(0)
  chat_id                         Int
  sender_id                       Int

  chat                            chat      @relation(fields: [chat_id], references: [chat_id], onUpdate: Restrict)
  user_messages_sender_idTouser   user?     @relation("messages_sender_idTouser", fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sender_id])
  @@index([chat_id])
  @@index([chat_id, timestamp])              // Most important for loading messages
  
  @@map("messages")
}

model package_bookings {
  booking_id          String                  @id @default(uuid())
  user_id             Int
  package_id          String
  tourism_booking_id  String?
  appointment_id      String?
  contact_id          String?
  price               Float
  create_at           DateTime                @default(now()) @db.Timestamp(0)
  status              package_bookings_status @default(In_Progress)
  appointments        appointments?           @relation(fields: [appointment_id], references: [appointment_id], onDelete: NoAction, onUpdate: NoAction)
  user_contact_detail user_contact_detail?    @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packages            packages                @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction)
  tourism_bookings    tourism_bookings?       @relation(fields: [tourism_booking_id], references: [tourism_id], onDelete: NoAction, onUpdate: NoAction)
  user                user                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment             payment[]

  @@index([user_id])
  @@index([package_id])
  @@index([tourism_booking_id])
  @@index([appointment_id])
  @@index([contact_id])
}


model package_image {
  image_id   Int       @id @default(autoincrement())
  package_id String?
  url        String   @db.VarChar(255)
  alt        String?
  packages   packages? @relation(fields: [package_id], references: [package_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([package_id])
}

model attractions {
  attraction_id Int     @id @default(autoincrement())
  route_id      Int
  place_id     String
  places       places @relation(fields: [place_id], references: [place_id], onDelete: NoAction, onUpdate: NoAction)
  routes       routes  @relation(fields: [route_id], references: [route_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([route_id])
  @@index([place_id])
}

model packages {
  package_id           String                 @id @default(uuid())
  package_name         String                 @db.VarChar(255)
  package_type         packages_package_type
  tour_id              Int
  hospital_id          String
  image                String                 @db.VarChar(255)
  detail               String                 @db.VarChar(100)
  expired_date         DateTime?               @db.Date
  status               package_status         @default(Active)
  create_at            DateTime               @default(now()) @db.Timestamp(0)
  description          description[]
  package_bookings     package_bookings[]
  package_image        package_image[]
  hospitals            hospitals              @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction)
  trips                trips                 @relation(fields: [tour_id], references: [tour_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tour_id])
  @@index([hospital_id])
}

model payment {
  payment_date     DateTime
  payment_method   String                 @db.VarChar(255)
  amount           Decimal                @db.Decimal(10, 0)
  payment_status   payment_payment_status
  transaction_id   String                 @db.VarChar(50)
  booking_id       String
  payment_id       String                 @id @default(uuid())
  user_id          Int
  package_bookings package_bookings       @relation(fields: [booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction)
  user             user                   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([booking_id])
}

model place_image {
  image_id Int     @id @default(autoincrement())
  place_id String?
  url      String @db.VarChar(255)
  places   places? @relation(fields: [place_id], references: [place_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([place_id])
}

model places {
  place_id       String           @id @default(uuid())
  name           String          @db.VarChar(100)
  contact_info   String          @db.VarChar(255)
  city           String          @db.VarChar(255)
  image          String          @db.VarChar(255)
  description    String
  fee            Float
  includes       includes[]
  important_info important_info?
  highlights     highlights[]
  location       location?
  attractions    attractions[]
  place_image    place_image[]
}

model includes {
  id    Int @id @default(autoincrement())
  place_id            String?
  place               places?                 @relation(fields: [place_id], references: [place_id], onDelete: Cascade)
  text                String
}

model highlights {
  id      Int @id @default(autoincrement())
  place_id            String?
  place               places?                 @relation(fields: [place_id], references: [place_id], onDelete: Cascade)
  text                String
}

model important_info {
  info_id             Int                    @id @default(autoincrement())
  place_id            String                 @unique
  place               places                 @relation(fields: [place_id], references: [place_id], onDelete: Cascade)
  not_allowed         not_allowed[]
  recommend_to_bring  recommend_to_bring[]
  know_before_you_go  know_before_you_go[]
}

model not_allowed {
  id          Int             @id @default(autoincrement())
  info_id     Int
  text        String
  important_info important_info @relation(fields: [info_id], references: [info_id], onDelete: Cascade)
}

model recommend_to_bring {
  id          Int             @id @default(autoincrement())
  info_id     Int
  text        String
  important_info important_info @relation(fields: [info_id], references: [info_id], onDelete: Cascade)
}

model know_before_you_go {
  id          Int             @id @default(autoincrement())
  info_id     Int
  text        String
  important_info important_info @relation(fields: [info_id], references: [info_id], onDelete: Cascade)
}

model location {
  location_id Int @id @default(autoincrement())
  text        String
  url         String
  place_id            String                 @unique
  place               places                 @relation(fields: [place_id], references: [place_id], onDelete: Cascade)
}

model review_hospital {
  review_id    Int       @id @default(autoincrement())
  user_id      Int
  hospital_id  String
  rating       Float?
  title_review String?
  comment      String?
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  hospitals    hospitals @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction)
  user         user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([hospital_id])
}

model tourism_bookings {
  tourism_id       String                   @id @default(uuid())
  route_id         Int
  guide_booking_id         Int?
  child            Int
  adult            Int
  start            DateTime
  end              DateTime                      
  status           tourism_bookings_status? @default(In_Progress)
  created_at       DateTime                 @default(now()) @db.Timestamp(0)
  updated_at       DateTime                 @default(now()) @db.Timestamp(0)
  package_bookings package_bookings[]
  guide_bookings   guide_bookings?        @relation(fields: [guide_booking_id], references: [booking_id], onDelete: NoAction, onUpdate: NoAction)
  routes           routes                   @relation(fields: [route_id], references: [route_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([route_id])
  @@index([guide_booking_id])
}

model hospital_images {
  image_id    Int        @id @default(autoincrement())
  hospital_id String
  image       String    @db.VarChar(255)
  hospitals   hospitals? @relation(fields: [hospital_id], references: [hospital_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hospital_id])
}

model chat {
  chat_id                  Int        @id @default(autoincrement())
  topic                    String
  customerId               Int
  staffId                  Int?
  timestamp                DateTime   @default(now()) @db.Timestamp(0)
  user_chat_user1_idTouser user       @relation("chat_user1_idTouser", fields: [customerId], references: [id], onUpdate: Restrict)
  user_chat_user2_idTouser user?      @relation("chat_user2_idTouser", fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages                 messages[]

  @@index([customerId])
  @@index([staffId])
}

model patient_details {
  patient_id      Int                     @id @default(autoincrement())
  appointment_id  String
  firstname       String?                 @db.VarChar(255)
  lastname        String?                 @db.VarChar(255)
  gender          patient_details_gender?
  dateofbirth     DateTime?               @db.Date
  nationality     String?                 @db.VarChar(255)
  passport_number String?                 @db.VarChar(255)
  appointments    appointments            @relation(fields: [appointment_id], references: [appointment_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appointment_id])
}

model trips {
  tour_id          Int                @id @default(autoincrement())
  city             String
  description      String
  languages        languages[]
  Trip_Routes      Trip_Routes[]
  packages         packages[]
  images           images[]
}

model languages {
  language_id       Int         @id @default(autoincrement())
  name              String
  flag              String
  trip_id           Int

  trips            trips            @relation(fields: [trip_id], references: [tour_id], onUpdate: Restrict)

  @@index([trip_id])
}

model Trip_Routes {
  trip_route_id    Int @id @default(autoincrement())
  trip_id          Int
  route_id         Int

  routes           routes           @relation(fields: [route_id], references: [route_id], onUpdate: Restrict)
  trips            trips            @relation(fields: [trip_id], references: [tour_id], onUpdate: Restrict)

  @@index([trip_id])
  @@index([route_id])
}

model images {
  image_id   Int @id @default(autoincrement())
  tour_id    Int
  url        String @db.VarChar(255)
  alt        String?
  trips      trips @relation(fields: [tour_id], references: [tour_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tour_id])
}

model routes {
  route_id         Int @id @default(autoincrement())
  title            String
  image            String
  duration         Int
  adult_price      Float
  child_price      Float
  guide_price      Float
  car_service_price Float
  description      String
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  tags             tags[]
  attractions      attractions[]
  Trip_Routes      Trip_Routes[]
  tourism_bookings tourism_bookings[]
}

model tags {
  tag_id     Int @id @default(autoincrement())
  route_id   Int
  tag        String
  routes     routes  @relation(fields: [route_id], references: [route_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([route_id])
}

model contact_us {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String   @unique(map: "Contact_Us_email_key")
  phoneNumber String
  country     String
  type        String
  message     String
  contact_us_status contact_us_status @default(Pending)
  createdAt   DateTime @default(now())
}

model user {
  id                                  Int                @id @default(autoincrement())
  name                                String?
  email                               String             @db.VarChar(255)
  nationality                         String?            @db.VarChar(255)
  image                               String?            @db.VarChar(2048)
  role                                user_role          @default(customer)
  otp                                 String?            @db.VarChar(10)
  otp_expiry                          DateTime?
  is_email_verified                   Boolean            @default(false)
  createdAt                           DateTime           @default(now())
  updatedAt                           DateTime           @updatedAt
  account                             account[]
  action_history                      action_history[]
  chat_chat_user1_idTouser            chat[]             @relation("chat_user1_idTouser")
  chat_chat_user2_idTouser            chat[]             @relation("chat_user2_idTouser")
  files                               File[]
  messages_messages_sender_idTouser   messages[]         @relation("messages_sender_idTouser")
  package_bookings                    package_bookings[]
  payment                             payment[]
  review_hospital                     review_hospital[]
}

model user_contact_detail {
  id               String             @id @default(uuid())
  firstname        String?            @db.VarChar(255)
  lastname         String?            @db.VarChar(255)
  email            String?            @db.VarChar(255)
  country          String?            @db.VarChar(255)
  phone            Int?
  package_bookings package_bookings[]
}

model account {
  id                String  @id
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

enum action_history_type_action {
  Add
  Remove
  Update
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
  
  @@map("message_type")
}

enum contact_us_status {
  Resolved
  In_Progress
  Rejected
  Pending
}

enum payment_payment_status {
  Successful
  Failed
  Pending
  Refund
}

enum patient_details_gender {
  Male
  Female
}

enum user_role {
  customer
  staff
  admin
}

enum tourism_bookings_status {
  In_Progress
  Pending
  Approved
  Rejected
}

enum guide_bookings_status {
  In_Progress
  Pending
  Approved
  Rejected
  Cancelled
}

enum guide_languages {
  English
  Arabic
  Myanmar
  Chinese
}

enum package_bookings_status {
  In_Progress
  Pending
  Approved
  Completed
  Rejected
  Cancelled
}

enum appointments_status {
  In_Progress
  Pending
  Approved
  Rejected
  Completed
  Cancelled
}

enum FileCategory {
  CHAT_ATTACHMENT
  MEDICAL_REPORT
  DOCUMENT
}

enum packages_package_type {
  Medical_Tourism
  Medical_Service_Only
}

enum package_status {
  Active
  Inactive
}
